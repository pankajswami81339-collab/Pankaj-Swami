# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Database & Cache
DATABASE_URL=
REDIS_URL=

# Encryption Key (AES-256 32-byte hexadecimal key for at-rest token security)
ENCRYPTION_KEY=

# Meta WhatsApp Cloud API & Facebook Ecosystem Embedded Signup, OAuth & Webhooks
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# AI Integrations (Gemini / OpenAI abstraction)
AI_API_KEY=
OPENAI_API_KEY=

# Billing & Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

